# Copy to `.env` and fill in. NEVER commit `.env`.
# Every variable listed under "REQUIRED IN PRODUCTION" has no default --
# the app refuses to start without it rather than silently falling back to a
# development value.

# ---------------------------------------------------------------- environment
# dev | prod   (defaults to dev)
DJANGO_ENV=dev

# ---------------------------------------------------------------------- secrets
# REQUIRED IN PRODUCTION. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# ------------------------------------------------------------------- web server
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com
# Required whenever the site is served over https
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# ------------------------------------------------------------------------ i18n
LANGUAGE_CODE=en
TIME_ZONE=Europe/Berlin

# ---------------------------------------------------------------------- database
# REQUIRED IN PRODUCTION. PostgreSQL only -- SQLite does not survive a deploy.
#   DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://realestate:changeme@localhost:5432/realestate

# -------------------------------------------------------------------------- email
# REQUIRED IN PRODUCTION. Use a transactional provider (SES/Postmark/Mailgun).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.postmarkapp.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@example.com
SERVER_EMAIL=noreply@example.com
# mandatory | optional | none
ACCOUNT_EMAIL_VERIFICATION=mandatory

# ------------------------------------------------------------- google oauth
# Optional. If left blank, remove the allauth entries from INSTALLED_APPS and
# the include() in project/urls.py -- see MANUAL.md.
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------ google maps
# REQUIRED to render the map on listing pages. Without it the map is omitted
# rather than rendered broken.
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------- media / object storage
# REQUIRED IN PRODUCTION if you use S3. Property photos and buyer exposés are
# private; they are served through signed URLs, never as public files.
# Console: https://console.aws.amazon.com/s3/home
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-central-1
# AWS_S3_ENDPOINT_URL=  (leave blank for real AWS)

# -------------------------------------------------------------------- geocoding
# REQUIRED IN PRODUCTION. Nominatim's usage policy requires a real, contactable
# User-Agent; a bare app name gets you rate-limited and eventually blocked.
#   https://operations.osmfoundation.org/policies/nominatim/
NOMINATIM_USER_AGENT=RealEstate/1.0 (https://example.com; contact@example.com)
GEOCODING_CACHE_SECONDS=604800
